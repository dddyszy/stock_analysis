# 复制为 .env 后按需修改

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=123456
DB_NAME=chan_stock

# mcp：腾讯自选股 westock-mcp（需在设置页完成授权）；mock：本地合成数据，用于未授权时开发
DATA_PROVIDER=mcp
# public：K 线与行情走腾讯公开接口（推荐，MCP 行情类工具限频约每分钟 3~5 次）；mcp：全部走 MCP
KLINE_SOURCE=public
MCP_URL=https://stockbuddy.qq.com/cgi/cgi-bin/openai/mcp/mcp
MCP_OAUTH_REDIRECT_URI=http://localhost:8000/api/auth/mcp/callback
MCP_MAX_CONCURRENCY=4
MCP_RATE_PER_SECOND=5

# 纳入分析的交易所（逗号分隔）：sh 沪市、sz 深市、bj 北交所
EXCHANGES=sh,sz

FRONTEND_URL=http://localhost:5173

SCHEDULER_ENABLED=true
BACKFILL_YEARS=5
QUOTE_BATCH_SIZE=50

APP_SYNC_ENABLED=true
APP_SYNC_GROUP_NAME=缠论推荐
